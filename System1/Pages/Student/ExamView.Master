            max-width: 100%;
            left: -54px;
            top: 309px;
            padding-left: 15px;
            padding-right: 15px;
            height: 173px;
        }

       
             .auto-style2 {
            position: relative;
            display: flex;
            -ms-flex-wrap: wrap;
