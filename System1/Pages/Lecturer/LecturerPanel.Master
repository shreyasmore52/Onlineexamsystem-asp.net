<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="LecturerPanel.Master.cs" Inherits="System1.Pages.Lecturer.LecturerIndex" %>

<!DOCTYPE html>

<html>
<head runat="server">
       <meta charset="UTF-8">
      <title>Online Exam </title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
   
    <link rel="shortcut icon" type="image/x-icon" href="/assets/img/favicon.ico">

    <link href="../../Content/bootstrap.min.css" rel="stylesheet" />

     <script src="https://kit.fontawesome.com/b99e675b6e.js"></script>

     <link href="../../Content/Styles.css" rel="stylesheet" />
        
        <script src="../../Scripts/jquery-3.0.0.min.js"></script>
        <script src="../../Scripts/popper.min.js"></script>
        <script src="../../Scripts/bootstrap.min.js"></script>

     <script>
         $(document).ready(function () {
             $(".siderbar_menu li").click(function () {
                 $(".siderbar_menu li").removeClass("active");
                 $(this).addClass("active");
             });

             $(".hamburger").click(function () {
                 $(".wrapper").addClass("active");
             });

             $(".close, .bg_shadow").click(function () {
                 $(".wrapper").removeClass("active");
             });
         });
     </script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div>
             <style type="text/css">
        .auto-style1 {
            position: relative;
            width: 100%;
            -ms-flex: 0 0 100%;
            flex: 0 0 100%;
            max-width: 100%;
            left: -54px;
            top: 609px;
            padding-left: 15px;
            padding-right: 15px;
        }
    </style>
    
          <div class="wrapper">
            <div class="sidebar">
                <div class="bg_shadow"></div>
                <div class="sidebar_inner">
                    <div class="close">
                        <i class="fas fa-times"></i>
                    </div>

                    <div class="profile_info">
                        <div class="profile_img">
                          
                        </div>
                        <div class="profile_data">
                            <p class="name">Teacher Panel</p>
                            <span><i class="fas fa-map-marker-alt"></i>Sangli, India</span>
                        </div>
                    </div>

                    <ul class="siderbar_menu">
                        <li>
                            <a href="/Pages/Lecturer/LecturerIndex.aspx">
                                <div class="icon"><i class="fas fa-home"></i></div>
                                <div class="title">Home</div>
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                <div class="icon"><i class="fas fa-user-tie"></i></div>
                                <div class="title">Question Bank</div>
                                <div class="arrow"><i class="fas fa-chevron-down"></i></div>
                            </a>
                            <ul class="accordion">
                                <li><a href="/Pages/Lecturer/AddExam.aspx" class="active"><i class="fas fa-user-plus pr-1"></i>Add Question Exam</a></li>
                                <li><a href="/Pages/Lecturer/ShowAllPapers.aspx" class="active"><i class="fas fa-user-plus pr-1"></i>Show Question Paper</a></li>
                            </ul>
                        </li>

                        <li>
                            <a href="/Pages/Lecturer/Result.aspx" class="active">
                                <div class="icon"><i class="fas fa-user-graduate"></i></div>
                                <div class="title">Exam Result</div>
                                <div class="arrow"><i class="fas fa-chevron-down"></i></div>
                            </a>
                        </li>

                        <li>
                            <a href="/Pages/Lecturer/FeedBack.aspx" class="active">
                                <div class="icon"><i class="fas fa-calendar-alt"></i></div>
                                <div class="title">FeedBack</div>
                            </a>
                        </li>

                        <li>
                            <a href="/Pages/Lecturer/Settings.aspx" class="active">
                                <div class="icon"><i class="fas fa-calendar-alt"></i></div>
                                <div class="title">Settings</div>
                            </a>
                        </li>
                    </ul>
                    <div class="logout_btn">
                        <asp:LinkButton ID="btnLogOut" runat="server" CausesValidation="false">Logout</asp:LinkButton>
                    </div>

                </div>
            </div>
            <div class="main_container">
                <div class="navbar">
                    <div class="hamburger">
                        <i class="fas fa-bars"></i>
                    </div>
                    <div class="logo">
                        <a href="#">Online Exam System</a>
                    </div>

                    <div style="display:flex;justify-content:center;align-items:center;">
                    <div class="logo">
                        <div style="width:35px;height:35px;border-radius:50%;background-color:red;"><div>
                        
                    </div>
                    <div><p>Hello Lecturer</p></div>
                         </div>
             </div>   </div>
    </div>
    
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
              <div>
                <footer>
            
                        <div class="footer-bottom">
                            <div class="row d-flex align-items-center">
                                <div class="auto-style1">
                                    <div class="footer-copy-right text-center">
                                        <p>&copy; <script>document.write(new Date().getFullYear());</script> All rights reserved. This Made By  <i class="fa fa-heart" aria-hidden="true"></i> by <a href="#" target="_blank">Ritesh & Shreyas</a></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </footer>
        <!-- Footer End -->

          </div>

                    </div>
            </div>
        </div>
    </form>
</body>
</html>
